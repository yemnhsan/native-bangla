#include <windows.h>

#define VER_FILEVERSION             0,1,0,0
#define VER_FILEVERSION_STR         "0.1.0.0\0"
#define VER_PRODUCTVERSION          0,1,0,0
#define VER_PRODUCTVERSION_STR       "0.1.0.0\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Native Bangla Contributors\0"
            VALUE "FileDescription",  "Native Bangla Input Method Editor\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "NativeBanglaIME\0"
            VALUE "LegalCopyright",   "Copyright (c) Native Bangla Contributors. MIT License.\0"
            VALUE "OriginalFilename", "NativeBanglaIME.dll\0"
            VALUE "ProductName",      "Native Bangla\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         "Type Naturally. Write Beautifully.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
